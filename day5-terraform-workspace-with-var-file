  }
  web2 = {
    vm_size = "Standard_F2as_v7"
    availability_zone = "2" #each.value.availability_zone 1
    subnet_id = "web"
  }
}

#lets test it
  1. withought passing variables you will see it is creating three instance as per instan-object-varaibles.tf file where you will find the number of instance
  terraform plan
  2. lets pass the dev.tfvars you will see it is creating single instance bcz in dev.tfvars we have put only one single instance
  terraform plan --var-file=dev.tfvars
  3. lets pass the test.tfvars you will see it is planning with two vm instance web1 and web2
   terraform plan --var-file=test.tfvars   
  3. we can pass this varaibles with command line also withught using any varaibles files
  terraform plan --var="environment=prod" --var="project_name=projectx"

