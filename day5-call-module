##create a file main.tf copy line 113 till 122 inside main.tf change the line number 112 to your github link click on netowrking folder copy the whole linke and paste inisde source block 
  #remover /tree/main
  #remove https from starting
  module "networking" {
    source = "github.com/gopal1409/kyn25-terraform-module-sep-last26/modules/networking"
    project_name = var.project_name
    environment = var.environment
    resource_group_name = var.resource_group_name
    location = var.resource_group_location
    vnet_address_space = var.vnet_address_space
    web_subnet_address = var.web_subnet_address
    tags = local.project_tags
}

